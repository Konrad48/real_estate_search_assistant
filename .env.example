# Enrichment (uzupełnianie danych ze stron ogłoszeń + AI).
# Copy to .env.local. Without OPENAI_API_KEY everything still works — the app
# just fills only what an offer page states outright and skips the AI step.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

OPENAI_MODEL=gpt-5-nano

ENRICH_MAX_PER_RUN=400
